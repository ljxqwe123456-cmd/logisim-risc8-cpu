00  2810A5          LDI R1, 0xA5     ; 被移的数
01  282002          LDI R2, 2        ; 走寄存器的那份移位量
02  17AA00          MOV R10, R10     ; 填充两拍：让 04 起读 R1 都落在 k>=4
03  17AA00          MOV R10, R10
04  293101          SLL R3, R1, #1   ; 0xA5 << 1  = 0x4A
05  2A4101          SRL R4, R1, #1   ; 0xA5 >> 1  = 0x52
06  2B5101          SRA R5, R1, #1   ; 0xA5 >>> 1 = 0xD2（算术：高位补符号位）
07  1A6120          SRL R6, R1, R2   ; 0xA5 >> 2  = 0x29（移位量从 Rs2 来）
08  298108          SLL R8, R1, #8   ; ≥8：整字节移空    = 0x00
09  2B9108          SRA R9, R1, #8   ; ≥8 且带符号       = 0xFF
0A  107340          ADD R7, R3, R4   ; 折叠：0x4A + 0x52 = 0x9C
0B  107750          ADD R7, R7, R5   ; + 0xD2 = 0x6E
0C  107760          ADD R7, R7, R6   ; + 0x29 = 0x97
0D  107780          ADD R7, R7, R8   ; + 0x00 = 0x97
0E  107790          ADD R7, R7, R9   ; + 0xFF = 0x96
0F  A00700          OUT R7
10  B00000          HLT
