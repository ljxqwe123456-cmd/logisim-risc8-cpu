00  282040          LDI R2, 0x40     ; 基址（到 05 的 LD 相隔 k=5，走寄存器堆）
01  281011          LDI R1, 0x11
02  400140          STA R1, 0x40     ; RAM[0x40] = 0x11（丢掉偏移时会读到这里）
03  286033          LDI R6, 0x33
04  400644          STA R6, 0x44     ; RAM[0x44] = 0x33
05  C03204          LD  R3, [R2+#4]  ; R3 = RAM[0x40 + 4] = 0x33
06  177700          MOV R7, R7       ; 填充：把 R3 与 09 的 OUT 拉开到 k=4，避开 load-use
07  177700          MOV R7, R7
08  177700          MOV R7, R7
09  A00300          OUT R3           ; 0x33
0A  B00000          HLT
