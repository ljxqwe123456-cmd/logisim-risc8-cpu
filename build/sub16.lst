00  181002          LDI R1, 0x02     ; A 高字节
01  183000          LDI R3, 0x00     ; B 高字节   <- 排在这里（而非紧跟 R2）是为了把它推离 SBC 到 k=4
02  182000          LDI R2, 0x00     ; A 低字节
03  184001          LDI R4, 0x01     ; B 低字节
04  025240          SUB R5, R2, R4   ; 低: 0x00 - 0x01 = 0xFF, 借位=1（C=0）   R2 距 02 k=2，R4 距 03 k=1
05  036130          SBC R6, R1, R3   ; 高: 0x02 - 0x00 - 借位 = 0x01             R1 距 00 k=5，R3 距 01 k=4
06  900500          OUT R5           ; 低字节 0xFF
07  900600          OUT R6           ; 高字节 0x01  → 结果 0x01FF
08  A00000          HLT
