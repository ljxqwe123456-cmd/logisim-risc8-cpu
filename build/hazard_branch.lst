00  281010          LDI R1, 0x10
01  282005          LDI R2, 5
02  173200          MOV R3, R2       ; R3 = 5（紧邻 BZ，k=1）
03  700306          BZ  R3, wrong    ; R3 ≠ 0，应【不】跳
04  A00300          OUT R3           ; 5    <- 正解走这里（优先级 1 当拍前递）
05  B00000          HLT
06  A00100  wrong:  OUT R1           ; 0x10 <- 误跳走这里
07  B00000          HLT
