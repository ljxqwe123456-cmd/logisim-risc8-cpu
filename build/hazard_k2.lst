00  285041          LDI R5, 0x41     ; 09 的 ST 用的地址寄存器（00 写 → 09 读，k=9，走寄存器堆）
01  28400F          LDI R4, 0x0F     ; 哨兵：优先级 2 缺失时 0E 读到的是它
02  28100F          LDI R1, 0x0F     ; 哨兵
03  2810A1          LDI R1, 0xA1     ; 写 Rd 的那条 —— 05 的 STA 在 k=2 读它
04  289000          LDI R9, 0        ; 填充，把上面那条与 05 拉开到正好 k=2
05  400140          STA R1, 0x40     ; RAM[0x40] = 0xA1，数据源走 A 口
06  28200F          LDI R2, 0x0F     ; 哨兵
07  2820B2          LDI R2, 0xB2     ; 写 Rd 的那条 —— 09 的 ST 在 k=2 读它
08  289000          LDI R9, 0        ; 填充
09  600520          ST  R2, [R5]     ; RAM[0x41] = 0xB2，数据源走 B 口
0A  283015          LDI R3, 0x15     ; ADD 的源，0C 在 k=2 读它
0B  289000          LDI R9, 0        ; 填充
0C  104330          ADD R4, R3, R3   ; R4 = 0x2A
0D  289000          LDI R9, 0        ; 填充，把 R4 与 0E 拉开到正好 k=2
0E  400442          STA R4, 0x42     ; RAM[0x42] = 0x2A，ALU 结果经 A 口
