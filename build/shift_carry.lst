00  282035          LDI R2, 0x35     ; 右移组高字节
01  2830C2          LDI R3, 0xC2     ; 右移组低字节   16 位值 = 0x35C2
02  28402B          LDI R4, 0x2B     ; 左移组高字节
03  285096          LDI R5, 0x96     ; 左移组低字节   16 位值 = 0x2B96
04  1D2200          SRC R2, R2       ; 16 位右移一位：高字节先走，C ← 它的 bit0
05  1D3300          SRC R3, R3       ; 低字节跟上，C 从 bit0 进 bit7
06  107230          ADD R7, R2, R3   ; 折叠右移结果：0x1A + 0xE1 = 0xFB
07  1C5500          SLC R5, R5       ; 16 位左移一位：低字节先走，C ← 它的 bit7
08  1C4400          SLC R4, R4       ; 高字节跟上，C 从 bit7 进 bit0
09  176600          MOV R6, R6       ; 填充：把 10 读 R7 从 k=3 推到 k=4
0A  107740          ADD R7, R7, R4   ; + 0x57 = 0x52
0B  107750          ADD R7, R7, R5   ; + 0x2C = 0x7E
0C  A00700          OUT R7
0D  B00000          HLT
