00  281000          LDI R1, 0        ; sum = 0
01  28200A          LDI R2, 10       ; n = 10
02  283001          LDI R3, 1        ; 常数 1
03  101120          ADD R1, R1, R2   ; sum += n
04  122230          SUB R2, R2, R3   ; n--
05  800203          BNZ R2, loop     ; n != 0 继续
06  A00100          OUT R1           ; 55
07  B00000          HLT
