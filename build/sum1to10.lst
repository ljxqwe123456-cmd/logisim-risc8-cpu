00  181000          LDI R1, 0        ; sum = 0
01  18200A          LDI R2, 10       ; n = 10
02  183001          LDI R3, 1        ; 常数 1
03  001120          ADD R1, R1, R2   ; sum += n
04  022230          SUB R2, R2, R3   ; n--
05  700203          BNZ R2, loop     ; n != 0 继续
06  900100          OUT R1           ; 55
07  A00000          HLT
