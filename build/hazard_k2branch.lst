00  281010          LDI R1, 0x10
01  282005          LDI R2, 5
02  173200          MOV R3, R2       ; R3 = 5（写 Rd 的那条，i=2）
03  174200          MOV R4, R2       ; 填充①：把写 R3 的那条推到 i-2，让 BZ 走 k=2
04  700308          BZ  R3, wrong    ; R3 = 5 ≠ 0，应【不】跳（停在优先级 2 这一路上）
05  285000          LDI R5, 0        ; 填充②：把 R3 与 OUT 的距离推到 k=4，避开 k=3
06  A00300          OUT R3           ; 5    <- 正解走这里
07  B00000          HLT
08  A00100  wrong:  OUT R1           ; 0x10 <- 误跳走这里
09  B00000          HLT
