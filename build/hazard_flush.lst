00  283000          LDI R3, 0        ; 判据寄存器：清 0
01  282001          LDI R2, 1        ; BNZ 的源，i=1
02  285000          LDI R5, 0        ; 填充 ×3：把 R2 与 05 的距离推到 k=4，避开前递
03  286000          LDI R6, 0
04  287000          LDI R7, 0
05  800208          BNZ R2, tgt      ; R2 = 1 ≠ 0 → 跳（taken），作废 06 与 07
06  283011          LDI R3, 0x11     ; <- 条件分支的白取指令
07  B00000          HLT
08  90000B  tgt:    JMP over         ; 无条件跳转，作废 09 与 10
09  283022          LDI R3, 0x22     ; <- JMP 的白取指令
0A  B00000          HLT
0B  A00300  over:   OUT R3           ; 0x00 <- 正解走这里
0C  B00000          HLT
