00  181010          LDI R1, 0x10     ; 指针 = 数组基址
01  184001          LDI R4, 1        ; 常数 1
02  183003          LDI R3, 3        ; 元素个数
03  185005          LDI R5, 5
04  500150          ST  R5, [R1]     ; RAM[0x10] = 5
05  001140          ADD R1, R1, R4   ; 指针++
06  185007          LDI R5, 7
07  500150          ST  R5, [R1]     ; RAM[0x11] = 7
08  001140          ADD R1, R1, R4
09  185009          LDI R5, 9
0A  500150          ST  R5, [R1]     ; RAM[0x12] = 9
0B  181010          LDI R1, 0x10     ; 指针复位
0C  182000          LDI R2, 0        ; sum = 0
0D  405100          LD  R5, [R1]     ; R5 = *ptr
0E  002250          ADD R2, R2, R5   ; sum += *ptr
0F  001140          ADD R1, R1, R4   ; ptr++
10  023340          SUB R3, R3, R4   ; count--
11  70030D          BNZ R3, sumloop
12  900200          OUT R2           ; 5+7+9 = 21
13  A00000          HLT
