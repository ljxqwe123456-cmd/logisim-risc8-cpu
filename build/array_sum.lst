00  281010          LDI R1, 0x10     ; 指针 = 数组基址
01  284001          LDI R4, 1        ; 常数 1
02  283003          LDI R3, 3        ; 元素个数
03  285005          LDI R5, 5
04  600150          ST  R5, [R1]     ; RAM[0x10] = 5
05  101140          ADD R1, R1, R4   ; 指针++
06  285007          LDI R5, 7
07  600150          ST  R5, [R1]     ; RAM[0x11] = 7
08  101140          ADD R1, R1, R4
09  285009          LDI R5, 9
0A  600150          ST  R5, [R1]     ; RAM[0x12] = 9
0B  281010          LDI R1, 0x10     ; 指针复位
0C  282000          LDI R2, 0        ; sum = 0
0D  505100          LD  R5, [R1]     ; R5 = *ptr
0E  102250          ADD R2, R2, R5   ; sum += *ptr
0F  101140          ADD R1, R1, R4   ; ptr++
10  123340          SUB R3, R3, R4   ; count--
11  80030D          BNZ R3, sumloop
12  A00200          OUT R2           ; 5+7+9 = 21
13  B00000          HLT
