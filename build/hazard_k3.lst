00  185000          LDI R5, 0
01  300510          STA R5, 0x10     ; 先把 RAM[0x10] 清 0，让判据不受 RAM 初值影响
02  181010          LDI R1, 0x10     ; 基址 —— 写 Rd 的那条
03  183000          LDI R3, 0        ; 填充，把 ST 与 LDI R1 拉开到正好 k=3
04  1820FF          LDI R2, 0xFF     ; 待写入的值（紧邻 ST，k=1，走 B 前递 → 写数据）
05  500120          ST  R2, [R1]     ; <- 用 R1，相隔 k=3
06  204010          LDA R4, 0x10     ; 用绝对地址读回，不依赖 R1
07  900400          OUT R4           ; 0xFF
08  A00000          HLT
