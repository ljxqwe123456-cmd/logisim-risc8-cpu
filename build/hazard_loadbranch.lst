00  181020          LDI R1, 0x20     ; 基址（写 Rd 的那条，i=0）
01  182005          LDI R2, 5
02  184000          LDI R4, 0        ; 填充：把 R1 与 LD 的距离推到 k=4，避开 k=3
03  300220          STA R2, 0x20     ; RAM[0x20] = 5
04  403100          LD  R3, [R1]     ; R3 = 5（写 R3 的那条是 load）
05  600308          BZ  R3, bad      ; R3 = 5 ≠ 0，应【不】跳（k=1 的 load→分支 → 要停 2 拍）
06  900300          OUT R3           ; 0x05 <- 正解走这里
07  A00000          HLT
08  900100  bad:    OUT R1           ; 0x20 <- 误跳走这里
09  A00000          HLT
