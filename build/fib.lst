00  181001          LDI R1, 1        ; F(1) = 1
01  182000          LDI R2, 0        ; F(0) = 0
02  18400A          LDI R4, 10       ; 输出 10 项
03  185001          LDI R5, 1        ; 常数 1
04  900100          OUT R1           ; 显示当前项
05  003120          ADD R3, R1, R2   ; R3 = F(n) + F(n-1) = F(n+1)
06  072100          MOV R2, R1       ; R2 ← F(n)      （R1 拷贝到 R2）
07  071300          MOV R1, R3       ; R1 ← F(n+1)    （R3 拷贝到 R1）
08  024450          SUB R4, R4, R5   ; 次数 -1
09  700404          BNZ R4, loop     ; 未完成则继续
0A  A00000          HLT
