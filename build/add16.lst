00  281000          LDI R1, 0x00     ; A 高字节
01  283000          LDI R3, 0x00     ; B 高字节   <- 排在这里（而非紧跟 R2）是为了把它推离 ADC 到 k=4
02  2820FF          LDI R2, 0xFF     ; A 低字节
03  284001          LDI R4, 0x01     ; B 低字节
04  105240          ADD R5, R2, R4   ; 低: 0xFF + 0x01 = 0x00, C=1（进位）  R2 距 02 k=2，R4 距 03 k=1
05  116130          ADC R6, R1, R3   ; 高: 0x00 + 0x00 + C = 0x01            R1 距 00 k=5，R3 距 01 k=4
06  A00500          OUT R5           ; 低字节 0x00
07  A00600          OUT R6           ; 高字节 0x01  → 结果 0x0100
08  B00000          HLT
